# RevoGarb — environment variable template
# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored; this file (.env.example) is committed with placeholders only.

# Public base URL of the RevoGarb API. Bare origin: no /api path, no trailing slash.
# Exposed to the browser (NEXT_PUBLIC_ prefix) because client components fetch from it too.
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# --- Playwright end-to-end test credentials ---
# Server-only: no NEXT_PUBLIC_ prefix, so these are never bundled into client JavaScript.
# The admin CRUD spec logs in with these. Keep real values in .env.local only.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your-admin-password
