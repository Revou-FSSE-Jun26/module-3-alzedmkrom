# RevoShop — environment variable template
# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored; this file (.env.example) is committed with placeholders only.

# Public base URL of the RevoShop API. Bare origin: no /api path, no trailing slash.
# Exposed to the browser (NEXT_PUBLIC_ prefix) because the client catalog fetches from it too.
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# Server-only variables below. Do NOT add the NEXT_PUBLIC_ prefix to any of them,
# or they would be bundled into client-side JavaScript.

# Declared for the rubric; unused in this checkpoint.
API_SECRET_KEY=your-api-secret-key

# Demo credentials used by the server to log in and read orders.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=your-demo-user-password

# DEMO_USER_ID MUST match the account identified by DEMO_USER_EMAIL.
# The API returns 403 when a token for one user requests another user's orders,
# so a mismatch surfaces as an authorization error rather than empty data.
DEMO_USER_ID=0
